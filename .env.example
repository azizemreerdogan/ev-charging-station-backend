NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ev_charging
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=1d
TAX_RATE=0.18
# Optional — when omitted, distance/render fall back to Haversine + raw lat/lng.
# Required for: address geocoding on station create, real driving ETA, Static Maps URLs.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_CACHE_TTL_SECONDS=300
STATIC_MAP_DEFAULT_SIZE=640x400
