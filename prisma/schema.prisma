// EV Charging System — Prisma schema
// Mirrors the domain model from the project requirements PDF (Section 5).

generator client {
    provider        = "prisma-client-js"
    previewFeatures = []
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    VEHICLE_OWNER
    OPERATOR
    ADMIN
}

enum AccountStatus {
    ACTIVE
    SUSPENDED
    DEACTIVATED
    ARREARS
}

enum ConnectorType {
    TYPE_1
    TYPE_2
    CCS
    CHADEMO
    TESLA
}

enum ConnectorStatus {
    AVAILABLE
    RESERVED
    IN_USE
    MAINTENANCE
    OFFLINE
}

enum StationStatus {
    ACTIVE
    MAINTENANCE
    OFFLINE
}

enum ReservationStatus {
    CONFIRMED
    ACTIVE
    COMPLETED
    CANCELLED
    EXPIRED
}

enum SessionStatus {
    ACTIVE
    COMPLETED
    STOPPED
    ERROR
}

enum PaymentMethod {
    CREDIT_CARD
    DEBIT_CARD
    DIGITAL_WALLET
    BANK_TRANSFER
    MOCK
}

enum PaymentStatus {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
}

model User {
    id           String        @id @default(uuid()) @db.Uuid
    email        String        @unique
    passwordHash String
    name         String
    phone        String?
    role         UserRole      @default(VEHICLE_OWNER)
    status       AccountStatus @default(ACTIVE)
    createdAt    DateTime      @default(now()) @db.Timestamptz
    updatedAt    DateTime      @updatedAt @db.Timestamptz
    deletedAt    DateTime?     @db.Timestamptz

    vehicles         Vehicle[]
    operatedStations ChargingStation[]   @relation("StationOperator")
    reservations     Reservation[]
    sessions         ChargingSession[]
    payments         Payment[]
    invoices         Invoice[]

    @@map("users")
}

model Vehicle {
    id             String          @id @default(uuid()) @db.Uuid
    userId         String          @db.Uuid
    user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    make           String
    model          String
    year           Int
    licensePlate   String          @unique
    batteryKwh     Float
    connectorTypes ConnectorType[]
    nickname       String?
    createdAt      DateTime        @default(now()) @db.Timestamptz
    deletedAt      DateTime?       @db.Timestamptz

    reservations Reservation[]
    sessions     ChargingSession[]

    @@index([userId])
    @@map("vehicles")
}

model ChargingStation {
    id             String        @id @default(uuid()) @db.Uuid
    operatorId     String        @db.Uuid
    operator       User          @relation("StationOperator", fields: [operatorId], references: [id])
    name           String
    latitude       Float
    longitude      Float
    address        String
    operatingHours String        @default("24/7")
    amenities      String[]      @default([])
    rating         Float?
    status         StationStatus @default(ACTIVE)
    createdAt      DateTime      @default(now()) @db.Timestamptz

    connectors Connector[]

    @@index([latitude, longitude])
    @@index([operatorId])
    @@map("charging_stations")
}

model Connector {
    id              String          @id @default(uuid()) @db.Uuid
    stationId       String          @db.Uuid
    station         ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
    connectorNumber Int
    type            ConnectorType
    powerKw         Float
    pricePerKwh     Decimal         @db.Decimal(10, 4)
    timeRatePerHour Decimal         @default(0) @db.Decimal(10, 4)
    status          ConnectorStatus @default(AVAILABLE)
    createdAt       DateTime        @default(now()) @db.Timestamptz

    reservations Reservation[]
    sessions     ChargingSession[]

    @@unique([stationId, connectorNumber])
    @@index([stationId, status])
    @@map("connectors")
}

model Reservation {
    id            String            @id @default(uuid()) @db.Uuid
    userId        String            @db.Uuid
    user          User              @relation(fields: [userId], references: [id])
    vehicleId     String            @db.Uuid
    vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
    connectorId   String            @db.Uuid
    connector     Connector         @relation(fields: [connectorId], references: [id])
    startTime     DateTime          @db.Timestamptz
    endTime       DateTime          @db.Timestamptz
    estimatedCost Decimal?          @db.Decimal(12, 2)
    status        ReservationStatus @default(CONFIRMED)
    createdAt     DateTime          @default(now()) @db.Timestamptz
    cancelledAt   DateTime?         @db.Timestamptz

    session ChargingSession?

    @@index([userId])
    @@index([connectorId, startTime, endTime])
    @@index([status])
    @@map("reservations")
}

model ChargingSession {
    id             String        @id @default(uuid()) @db.Uuid
    reservationId  String        @unique @db.Uuid
    reservation    Reservation   @relation(fields: [reservationId], references: [id])
    userId         String        @db.Uuid
    user           User          @relation(fields: [userId], references: [id])
    vehicleId      String        @db.Uuid
    vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
    connectorId    String        @db.Uuid
    connector      Connector     @relation(fields: [connectorId], references: [id])
    startTime      DateTime      @db.Timestamptz
    endTime        DateTime?     @db.Timestamptz
    energyKwh      Float         @default(0)
    costAmount     Decimal?      @db.Decimal(12, 2)
    paymentStatus  PaymentStatus @default(PENDING)
    status         SessionStatus @default(ACTIVE)
    createdAt      DateTime      @default(now()) @db.Timestamptz

    payment Payment?
    invoice Invoice?

    @@index([userId])
    @@index([connectorId])
    @@map("charging_sessions")
}

model Payment {
    id                  String          @id @default(uuid()) @db.Uuid
    sessionId           String          @unique @db.Uuid
    session             ChargingSession @relation(fields: [sessionId], references: [id])
    userId              String          @db.Uuid
    user                User            @relation(fields: [userId], references: [id])
    amount              Decimal         @db.Decimal(12, 2)
    currency            String          @default("USD")
    method              PaymentMethod   @default(MOCK)
    gatewayTransactionId String?
    status              PaymentStatus   @default(PENDING)
    paymentDate         DateTime        @default(now()) @db.Timestamptz

    @@index([userId])
    @@map("payments")
}

model Invoice {
    id             String          @id @default(uuid()) @db.Uuid
    invoiceNumber  String          @unique
    sessionId      String          @unique @db.Uuid
    session        ChargingSession @relation(fields: [sessionId], references: [id])
    userId         String          @db.Uuid
    user           User            @relation(fields: [userId], references: [id])
    energyCost     Decimal         @db.Decimal(12, 2)
    timeCost       Decimal         @default(0) @db.Decimal(12, 2)
    discountAmount Decimal         @default(0) @db.Decimal(12, 2)
    taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
    totalAmount    Decimal         @db.Decimal(12, 2)
    currency       String          @default("USD")
    createdAt      DateTime        @default(now()) @db.Timestamptz

    @@index([userId])
    @@map("invoices")
}
